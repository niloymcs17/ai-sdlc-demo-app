+using System.Globalization;
+
 namespace InvoiceApp.Domain;
 
 /// <summary>
 /// Moves an invoice through its lifecycle: Draft -> PendingApproval -> Approved or Rejected.
 /// One invoice at a time, decided as a whole by a single approver.
+/// A Manager may approve up to <see cref="ManagerApprovalLimit"/>; a Director up to <see cref="DirectorApprovalLimit"/>.
 /// </summary>
 public class ApprovalService
 {
+    public const decimal ManagerApprovalLimit = 50_000m;
+    public const decimal DirectorApprovalLimit = 500_000m;
+
     private readonly IInvoiceRepository _repository;
 
     public ApprovalService(IInvoiceRepository repository)
@@ -28,10 +34,11 @@ public class ApprovalService
         return invoice;
     }
 
-    public Invoice Approve(string invoiceId, string approver)
+    public Invoice Approve(string invoiceId, string approver, string role)
     {
         var invoice = Find(invoiceId);
         EnsurePending(invoice);
+        EnsureWithinRoleLimit(invoice, role);
 
         invoice.Status = InvoiceStatus.Approved;
         invoice.DecidedBy = approver;
@@ -70,4 +77,46 @@ public class ApprovalService
                 $"Invoice {invoice.Id} is {invoice.Status}; only pending invoices can be decided.");
         }
     }
+
+    /// <summary>
+    /// Refuses the approval before any field on the invoice is changed.
+    /// Boundaries are inclusive: an amount equal to the role limit is allowed.
+    /// </summary>
+    private static void EnsureWithinRoleLimit(Invoice invoice, string role)
+    {
+        if (!TryGetLimit(role, out var limit, out var roleName))
+        {
+            throw new InvalidOperationException($"Role '{role}' cannot approve invoices.");
+        }
+
+        if (invoice.Amount <= limit)
+        {
+            return;
+        }
+
+        var formattedLimit = limit.ToString("#,0", CultureInfo.InvariantCulture);
+        throw new InvalidOperationException(
+            $"Amount exceeds the {roleName} approval limit of {formattedLimit}.");
+    }
+
+    private static bool TryGetLimit(string role, out decimal limit, out string roleName)
+    {
+        if (string.Equals(role, ApprovalRoles.Manager, StringComparison.OrdinalIgnoreCase))
+        {
+            limit = ManagerApprovalLimit;
+            roleName = ApprovalRoles.Manager;
+            return true;
+        }
+
+        if (string.Equals(role, ApprovalRoles.Director, StringComparison.OrdinalIgnoreCase))
+        {
+            limit = DirectorApprovalLimit;
+            roleName = ApprovalRoles.Director;
+            return true;
+        }
+
+        limit = 0;
+        roleName = string.Empty;
+        return false;
+    }
 }
